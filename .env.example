# Where environments live. One folder per environment under accounts/<account>/<profile>/.
ENVAPI_ROOT=./data

# Keyring, the identity provider. Callers send a user token minted by
#     POST /v1/auth/service-token {"audience": "environments-api"}
# as Authorization: Bearer <token>, and this service verifies it against keyring's keys.
ENVAPI_KEYRING_BASE_URL=http://127.0.0.1:8001
# Who signs the tokens: exactly keyring's KEYRING_ISSUER, which behind a proxy is not
# necessarily the base URL above.
ENVAPI_KEYRING_ISSUER=http://127.0.0.1:8001
# This service's own token, 32+ characters, held by keyring under this service's name:
#     KEYRING_SERVICE_TOKENS='{"environments-api":"<the same value>"}'
# Generate one with `openssl rand -hex 32`. The value below is the one scripts/dev_keyring.py
# accepts by default; replace it before pointing at a real keyring.
ENVAPI_KEYRING_SERVICE_TOKEN=dev-keyring-service-token-not-for-production
# The audience user tokens must carry, and the name in KEYRING_SERVICE_TOKENS: change both.
ENVAPI_KEYRING_SERVICE_NAME=environments-api
ENVAPI_DEFAULT_PROFILE=personal
# --- Per-person settings (settings-api) ------------------------------------------
# Off unless both are set. Unset, every person gets the quotas above, which is today's
# behaviour exactly. Set, each create reads that caller's `environments` namespace:
# they may lower idle_environment_hours, idle_shell_minutes and
# max_environments_per_profile, never raise them above this deployment. Idle TTLs are
# stamped on the environment at create so the reaper (which has no user token) can
# honour them. common.default_profile replaces ENVAPI_DEFAULT_PROFILE when a request
# names no profile; during an outage that request is refused rather than guessed.
# The token is this service's entry in settings-api's SETTINGS_API_SERVICES (32+
# characters); the grant's audience_prefix must be environments-api. Neither value
# is logged.
#
# ENVAPI_SETTINGS_API_BASE_URL=http://127.0.0.1:8003
# ENVAPI_SETTINGS_API_TOKEN=
ENVAPI_JWKS_CACHE_SECONDS=3600
# The least time between key fetches an unknown key id may provoke.
ENVAPI_JWKS_MIN_REFETCH_SECONDS=60

# Sandbox. Refuse to boot below this tier: directory | user | namespace.
ENVAPI_MIN_SANDBOX_TIER=directory
ENVAPI_ALLOW_NETWORK=true
ENVAPI_SHELL_BINARY=/bin/bash

# Comma-separated keyring account ids allowed to use /v1/admin.
ENVAPI_OPERATOR_ACCOUNTS=
# Optional front-door gate: comma-separated keys accepted in X-API-Key. Empty disables.
ENVAPI_API_KEYS=

# Quotas (deployment-wide defaults; per-account overrides via /v1/admin/quotas).
ENVAPI_MAX_ENVIRONMENTS_PER_PROFILE=5
ENVAPI_MAX_ENVIRONMENTS_PER_ACCOUNT=20
ENVAPI_MAX_SHELLS_PER_ENVIRONMENT=8
ENVAPI_MAX_PROCESSES_PER_SHELL=256
ENVAPI_MAX_MEMORY_BYTES=2147483648
ENVAPI_MAX_FILE_SIZE_BYTES=536870912
ENVAPI_MAX_CPU_SECONDS=900
ENVAPI_MAX_DISK_BYTES=5368709120
ENVAPI_MAX_OUTPUT_BUFFER_BYTES=1048576
ENVAPI_MAX_COMMAND_LOG_BYTES=33554432
ENVAPI_ENVIRONMENT_IDLE_TTL_SECONDS=86400
ENVAPI_SHELL_IDLE_TTL_SECONDS=3600
ENVAPI_REAPER_INTERVAL_SECONDS=60
