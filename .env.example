# Where environments live. One folder per environment under accounts/<account>/<profile>/.
ENVAPI_ROOT=./data

# Keyring, the identity provider. The service token is the one keyring was started with
# in KEYRING_SERVICE_TOKENS for this service's name.
ENVAPI_KEYRING_BASE_URL=http://localhost:8000
ENVAPI_KEYRING_SERVICE_TOKEN=change-me
ENVAPI_KEYRING_SERVICE_NAME=environments-api
ENVAPI_DEFAULT_PROFILE=personal
ENVAPI_JWKS_CACHE_SECONDS=300

# Sandbox. Refuse to boot below this tier: directory | user | namespace.
ENVAPI_MIN_SANDBOX_TIER=directory
ENVAPI_ALLOW_NETWORK=true
ENVAPI_SHELL_BINARY=/bin/bash

# Comma-separated keyring account ids allowed to use /v1/admin.
ENVAPI_OPERATOR_ACCOUNTS=
# Optional front-door gate: comma-separated keys accepted in X-API-Key. Empty disables.
ENVAPI_API_KEYS=

# Quotas (deployment-wide defaults; per-account overrides via /v1/admin/quotas).
ENVAPI_MAX_ENVIRONMENTS_PER_PROFILE=5
ENVAPI_MAX_ENVIRONMENTS_PER_ACCOUNT=20
ENVAPI_MAX_SHELLS_PER_ENVIRONMENT=8
ENVAPI_MAX_PROCESSES_PER_SHELL=256
ENVAPI_MAX_MEMORY_BYTES=2147483648
ENVAPI_MAX_FILE_SIZE_BYTES=536870912
ENVAPI_MAX_CPU_SECONDS=900
ENVAPI_MAX_DISK_BYTES=5368709120
ENVAPI_MAX_OUTPUT_BUFFER_BYTES=1048576
ENVAPI_MAX_COMMAND_LOG_BYTES=33554432
ENVAPI_ENVIRONMENT_IDLE_TTL_SECONDS=86400
ENVAPI_SHELL_IDLE_TTL_SECONDS=3600
ENVAPI_REAPER_INTERVAL_SECONDS=60
